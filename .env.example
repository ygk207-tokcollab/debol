# Environment the Express server (server.ts + server/) actually reads.
# On Render these go in the service's Environment tab; locally put them in .env and export before
# `npm run dev` (this checkout does not load .env by itself - use `export $(grep -v '^#' .env | xargs)`
# or prepend each variable to the command).

# --- Persistence ---------------------------------------------------------------------------
# Leave DATABASE_URL empty and the app runs the original in-memory demo: orders reset on restart.
# Paste the NEON POOLED string (the host ends in -pooler). sslmode is translated by server/db.ts,
# so both `?sslmode=require` and a bare string work.
DATABASE_URL=
# Escape hatches for TLS negotiation, only needed if the host inference above is wrong:
#   DB_SSL=true|false forces TLS on or off; DB_SSL_VERIFY=false skips certificate verification.
DB_SSL=
DB_SSL_VERIFY=
DB_POOL_MAX=5
DB_CONNECT_ATTEMPTS=5

# --- Admin sign-in -------------------------------------------------------------------------
# At boot this is scrypt-hashed onto every active OWNER account that has no password yet, which is
# how a fresh Neon database (seeded from docs/api-samples, no hashes) becomes signable. Change the
# password later from the administrators screen; then this variable can be removed.
ADMIN_BOOTSTRAP_PASSWORD=
# Passwordless /admin/auth/dev-login. Ignored when NODE_ENV=production. Never enable in production.
ADMIN_DEV_LOGIN=false

# --- HTTP ----------------------------------------------------------------------------------
# Render injects PORT; set it yourself only when running elsewhere.
PORT=3000
# Comma-separated origins allowed to call the API from a browser. Leave empty when the frontend is
# served by this same process (the normal Render setup). Required when the SPA is hosted elsewhere.
ALLOWED_ORIGINS=

# --- Frontend build ------------------------------------------------------------------------
# Only needed when the API is NOT on the same host as the built SPA, e.g. Cloudflare Pages + Render.
# The image paths the API returns (/api/v1/media/images/<id>) are rewritten onto this origin.
VITE_API_BASE_URL=
