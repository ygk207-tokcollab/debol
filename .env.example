# Kids Store - environment template.
#
# Every variable below appears in backend/src/main/resources/application.yml as ${VAR:default}.
# Nothing here is auto-loaded: Spring Boot reads the process environment, so export these
# (bash: `set -a; source .env; set +a`) or set them in your platform's secret store.
# Values in this file are obviously fake placeholders. Do not commit real secrets.
#
# ─── Spring profile ────────────────────────────────────────────────────────────────────────────
# dev | demo | test | prod. Use `prod` in production: SecurityConfig refuses to start with
# DEV_AUTH_ENABLED=true when the active profile is prod or production.
SPRING_PROFILES_ACTIVE=dev

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────────────────────
# Local cluster listens on 127.0.0.1:5433; the login role used everywhere locally is `kidsstore`.
DB_HOST=127.0.0.1
DB_PORT=5433
# kidsstore_dev for scripts/run-backend.sh, kidsstore_demo for scripts/run-demo.ps1 + acceptance.
DB_NAME=kidsstore_dev
DB_USER=kidsstore
DB_PASSWORD=replace-me-local-only
# HikariCP pool ceiling.
DB_POOL_MAX=12

# ─── HTTP ──────────────────────────────────────────────────────────────────────────────────────
# Default 8080. The vite dev proxy and scripts/acceptance.mjs both expect 8090.
SERVER_PORT=8090

# ─── Secrets ───────────────────────────────────────────────────────────────────────────────────
# SECRET. HS256 signing key; JwtService requires at least 32 bytes and fails the first token
# call otherwise (the app still boots). Generate:  openssl rand -base64 48
JWT_SECRET=example-only-not-a-real-secret-change-me-0123456789abcdef

# SECRET. Token from @BotFather. Backend ONLY: never put it in a frontend bundle, a log line, or
# git. An admin token is never exposed by any endpoint (GET /api/v1/admin/telegram/status returns
# botTokenConfigured: true/false only).
TELEGRAM_BOT_TOKEN=0000000000:REPLACE-WITH-BOTFATHER-TOKEN-not-a-real-token

# ─── First administrator (AdminBootstrap) ──────────────────────────────────────────────────────
# Only applied when the `administrator` table is empty. Password must be >= 10 characters or the
# bootstrap is skipped with an error log. Rotate/delete this account after first login.
ADMIN_BOOTSTRAP_EMAIL=owner@your-domain.example
ADMIN_BOOTSTRAP_PASSWORD=replace-me-10-chars-minimum
ADMIN_BOOTSTRAP_NAME=Store owner

# ─── Security / sessions (Security.*) ──────────────────────────────────────────────────────────
# Minutes an admin JWT stays valid; CUSTOMER_TOKEN_DAYS in days.
ADMIN_TOKEN_MINUTES=480
CUSTOMER_TOKEN_DAYS=30
# CORS allowlist for /api/**, comma separated, exact origins (no trailing slash, no wildcard paths).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# DEV ONLY. Enables POST /api/v1/admin/auth/dev-login (passwordless OWNER token).
# Keep false in every deployment; startup is refused if true under a prod profile.
DEV_AUTH_ENABLED=false
# Phone-only customer sign-in. There is no SMS/OTP provider, so phone login still requires an
# existing order number + its receipt token as proof of ownership.
ALLOW_PHONE_LOGIN=true
# Fixed-window, in-process limits keyed by request.remoteAddr.
LOGIN_ATTEMPTS_PER_MINUTE=5
CHECKOUT_ATTEMPTS_PER_MINUTE=10
# Max accepted age of Telegram initData (auth_date). 0 disables the age check (not recommended).
INIT_DATA_MAX_AGE_SECONDS=86400

# ─── Telegram (kidsstore.telegram.*) ───────────────────────────────────────────────────────────
# Base URL of the Bot API. Point at the local stand-in (scripts/telegram-stub.mjs) for offline work.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_ENABLED=true
# Long polling worker (/start, pairing, inline buttons). Must be false if you register a webhook,
# and only one instance may poll. Local scripts set this to false.
TELEGRAM_POLLING_ENABLED=true
# Read from config but clamped: PollingWorker uses min(value, 5) and the client caps at 50.
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
# NOT READ BY CODE - the pairing expiry is hardcoded to 15 minutes in TelegramPairingService.
# Kept listed because application.yml binds it. See docs/ENVIRONMENT.md.
TELEGRAM_PAIRING_TTL_MINUTES=15
# The store owner's phone number, used as the pairing contact label and as the bootstrap admin's
# phone. It is NOT a chat id and cannot be used to send Telegram messages.
TELEGRAM_ADMIN_CONTACT_PHONE=0911526922
# Reject inline-button callbacks whose chat id differs from the paired admin chat.
TELEGRAM_ENFORCE_CALLBACK_CHAT=true
TELEGRAM_DISPATCH_BATCH_SIZE=10
TELEGRAM_DISPATCH_INTERVAL_MS=5000
TELEGRAM_BACKOFF_BASE_SECONDS=15
TELEGRAM_BACKOFF_MAX_SECONDS=1800
# NOT READ BY CODE - outbox rows are created with maxAttempts = 8 in NotificationService.
TELEGRAM_MAX_ATTEMPTS=8

# ─── Storage (kidsstore.storage.*) ─────────────────────────────────────────────────────────────
# NOT READ BY CODE - only the local filesystem driver is implemented. `s3` does nothing yet.
STORAGE_DRIVER=local
# Relative paths resolve against the process working directory; the demo script points this at
# <repo>/data/uploads. Also the directory WebConfig serves under STORAGE_PUBLIC_BASE_URL.
STORAGE_LOCAL_DIR=./data/uploads
# Public path prefix for uploaded images (permitAll in SecurityConfig).
STORAGE_PUBLIC_BASE_URL=/api/v1/media
# Application-level size check (returns 400 image_too_large). spring.servlet.multipart.max-file-size
# is set higher (20MB) on purpose so an oversized file reaches this check and gets a readable error.
STORAGE_MAX_UPLOAD_BYTES=8388608

# ─── Currency + logging ────────────────────────────────────────────────────────────────────────
# NOT READ BY CODE - the storefront currency comes from store_settings.currency (ETB in V2).
CURRENCY_LABEL=ETB
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN

# ─── Frontend (build/dev-time only, read by vite.config.ts and src/lib/api.ts) ──────────────────
# Vite dev-server proxy target for /api (dev only; never reaches the bundle).
VITE_BACKEND_URL=http://127.0.0.1:8090
# Vite dev-server port.
VITE_PORT=5173
# Baked into the bundle at build time. Leave unset for same-origin hosting (dev proxy, nginx),
# where /api/v1 is resolved against the page origin. Set the full API origin only when the frontend
# is hosted separately, e.g. VITE_API_BASE_URL=https://debol-backend.onrender.com/api/v1
# Uploaded image URLs (/api/v1/media/...) are rewritten onto that origin by src/lib/api.ts.
# Nothing here is a secret: VITE_* values are public by design. Do not put JWT_SECRET or the bot
# token in any VITE_* variable.
VITE_API_BASE_URL=

# ─── scripts/ only ─────────────────────────────────────────────────────────────────────────────
# Node Telegram stub port (scripts/telegram-stub.mjs).
STUB_PORT=9099
